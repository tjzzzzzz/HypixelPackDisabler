{
  "schemaVersion": 1,
  "id": "hypixelpackdisabler",
  "version": "${version}",
  "name": "Hypixel Server Pack Disabler",
  "description": "Always-on mod that demotes Hypixel's server resource pack and layers the SkyBlock Legacy pack on top, so legacy textures win.",
  "authors": [
    "tj88888"
  ],
  "license": "LicenseRef-All-Rights-Reserved",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "dev.hypixelpackdisabler.HypixelPackDisabler"
      }
    ]
  },
  "mixins": [
    {
      "config": "hypixelpackdisabler.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  },
  "recommends": {
    "catharsis": "*"
  }
}
